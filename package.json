{
  "name": "@rowglass/cli",
  "version": "0.1.0",
  "description": "Reconcile CSV revenue, cost, and usage changes with exact decimals, composite keys, grouped totals, and offline reports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rowglass": "./bin/rowglass.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README*",
    "LICENSE",
    "docs/third-party-notices.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/rowglass.mjs demo --out demo.html --force",
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwakhyun/rowglass.git"
  },
  "homepage": "https://kwakhyun.github.io/rowglass/",
  "bugs": {
    "url": "https://github.com/kwakhyun/rowglass/issues"
  }
}
